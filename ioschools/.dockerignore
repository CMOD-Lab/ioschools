# .dockerignore for ioschools .NET Application
# Excludes build artifacts, IDE files, and non-essential content

# .NET build artifacts
bin/
obj/
publish/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# VS Code
.vscode/

# Rider
.idea/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet packages
*.nupkg
*.snupkg
.nuget/
packages/
!**/packages/build/

# Documentation
*.md
docs/

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
azure-pipelines.yml
Jenkinsfile

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Kubernetes
kubernetes/
scripts/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test projects
*Tests/
*Test/
*.Tests/
*.Test/

# Coverage reports
coverage/
*.coverage
*.coveragexml

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.swp
*~

# Launch settings (development only)
**/Properties/launchSettings.json

# Environment files
.env
.env.*
!.env.example
