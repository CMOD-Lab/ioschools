<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <!-- blocker-18 (cz-dotnet-1035): Hardcoded connection string replaced with environment variable DB_CONNECTION_STRING -->
        <!-- Inject via Kubernetes Secret: kubectl create secret generic ioschools-db-secret --from-literal=connection-string="..." -->
        <add name="ioschools.DB.Properties.Settings.ioschoolsConnectionString"
            connectionString="${DB_CONNECTION_STRING}" />
        <!-- blocker-19 (cz-dotnet-1035): Hardcoded connection string replaced with environment variable DB_CONNECTION_STRING_T -->
        <!-- blocker-20 (cz-dotnet-1035): Provider name kept; connection string injected via Kubernetes Secret -->
        <add name="ioschools.DB.Properties.Settings.tConnectionString"
            connectionString="${DB_CONNECTION_STRING_T}"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
